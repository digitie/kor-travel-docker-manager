#!/usr/bin/bash
# M05 disposable bridge runtime을 정확히 한 번만 실행하는 root launcher.
set -euo pipefail

if [[ "$#" != 2 ]]; then
  echo "usage: run-m05-isolated-e2e-once EXPECTED_MANAGER_SOURCE_REVISION ROOT_OWNED_OUTPUT_DIRECTORY" >&2
  exit 2
fi
if [[ "$(id -u)" != 0 ]]; then
  echo "M05 isolated launcher must run as root" >&2
  exit 2
fi
expected_revision="$1"
output_dir="$2"
if [[ ! "$expected_revision" =~ ^[0-9a-f]{40}$ || "$output_dir" != /* || -e "$output_dir" ]]; then
  echo "M05 isolated launcher arguments are invalid" >&2
  exit 2
fi

# rebuild one-shot과 동일한 host-global lock을 process lifetime 전체에 보존한다.
if [[ -z "${KTDM_PINNED_REBUILD_GLOBAL_LOCK_FD:-}" ]]; then
  exec /usr/bin/python3 -I -S - "${BASH_SOURCE[0]}" "$@" <<'PY'
import fcntl
import os
from pathlib import Path
import stat
import sys

script = Path(sys.argv[1]).resolve(strict=True)
arguments = sys.argv[2:]
directory = Path("/run/lock/kor-travel-docker-manager")
path = directory / "global-mutation.lock"
directory.mkdir(mode=0o700, parents=True, exist_ok=True)
metadata = directory.lstat()
if (stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != 0 or stat.S_IMODE(metadata.st_mode) != 0o700):
    raise SystemExit("M05 global mutation lock directory is unsafe")
if not hasattr(os, "O_NOFOLLOW"):
    raise SystemExit("M05 global mutation lock requires O_NOFOLLOW")
fd = os.open(path, os.O_CREAT | os.O_RDWR | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
opened = os.fstat(fd)
if (not stat.S_ISREG(opened.st_mode) or opened.st_nlink != 1
        or opened.st_uid != 0 or stat.S_IMODE(opened.st_mode) != 0o600):
    os.close(fd)
    raise SystemExit("M05 global mutation lock is unsafe")
try:
    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError as exc:
    os.close(fd)
    raise SystemExit("another manager mutation is already active") from exc
os.set_inheritable(fd, True)
env = dict(os.environ)
env["KTDM_PINNED_REBUILD_GLOBAL_LOCK_FD"] = str(fd)
os.execve("/usr/bin/bash", ["/usr/bin/bash", str(script), *arguments], env)
PY
fi

lock_fd="${KTDM_PINNED_REBUILD_GLOBAL_LOCK_FD}"
if [[ ! "$lock_fd" =~ ^[0-9]+$ ]]; then
  echo "M05 global mutation lock descriptor is invalid" >&2
  exit 2
fi
/usr/bin/python3 -I -S - "$lock_fd" <<'PY'
import fcntl
import os
from pathlib import Path
import stat
import sys

fd = int(sys.argv[1])
path = Path("/run/lock/kor-travel-docker-manager/global-mutation.lock")
opened = os.fstat(fd)
named = path.lstat()
if ((opened.st_dev, opened.st_ino) != (named.st_dev, named.st_ino)
        or not stat.S_ISREG(opened.st_mode) or opened.st_nlink != 1
        or opened.st_uid != 0 or stat.S_IMODE(opened.st_mode) != 0o600):
    raise SystemExit("M05 global mutation lock descriptor is unsafe")
try:
    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError as exc:
    raise SystemExit("M05 global mutation lock is not held") from exc
PY

parent="$(dirname "$output_dir")"
if [[ ! -d "$parent" || -L "$parent" || "$(stat -c '%u' "$parent")" != 0 ]]; then
  echo "M05 output parent is unsafe" >&2
  exit 2
fi
if (( 8#$(stat -c '%a' "$parent") & 022 )); then
  echo "M05 output parent is writable by another principal" >&2
  exit 2
fi

# terminal pinset은 Manager source revision이 바뀌어도 다시 실행하지 않는다. output leaf
# 생성보다 먼저 root registry와 공개 사본을 함께 검증해 blocked/stale 상태를 fail-close한다.
if ! /opt/kor-travel-docker-manager/backend/.venv/bin/ktdctl pin verify --json >/dev/null; then
  echo "M05 runtime pin registry is not runnable" >&2
  exit 1
fi
install -d -o root -g root -m 0700 "$output_dir"

set +e
/opt/kor-travel-docker-manager/backend/.venv/bin/python -I \
  /opt/kor-travel-docker-manager/scripts/m05_isolated_e2e.py \
  "$expected_revision" "$output_dir"
driver_status="$?"
set -e

# Driver가 terminal block까지 남기기 전에 interpreter/결과 쓰기 경계에서 끝나도, 원문
# stderr를 보관하거나 재시도 근거로 쓰지 않는다. 유효한 `result.json`만 그대로 수용하고
# 그 외에는 같은 one-shot을 terminal로 차단한 고정 envelope 하나를 쓴다.
result_path="$output_dir/result.json"
if /usr/bin/python3 -I -S - "$result_path" "$expected_revision" "$driver_status" <<'PY'
from __future__ import annotations

import json
import os
import pathlib
import stat
import sys

path = pathlib.Path(sys.argv[1])
expected_revision = sys.argv[2]
driver_status = int(sys.argv[3])
try:
    metadata = path.lstat()
    if (
        path.is_symlink()
        or not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != 0
        or stat.S_IMODE(metadata.st_mode) != 0o600
        or metadata.st_nlink != 1
    ):
        raise ValueError
    with path.open(encoding="utf-8") as handle:
        value = json.load(handle)
    if (
        not isinstance(value, dict)
        or value.get("manager_source_revision") != expected_revision
        or value.get("status") not in {"passed", "blocked"}
        or not isinstance(value.get("phase"), str)
        or not isinstance(value.get("driver_phase"), str)
        or not isinstance(value.get("cleanup_failed"), bool)
        or not isinstance(value.get("pinset_sha256"), str)
        or len(value["pinset_sha256"]) != 64
        or any(char not in "0123456789abcdef" for char in value["pinset_sha256"])
        or (value["status"] == "passed") != (driver_status == 0)
    ):
        raise ValueError
except (OSError, UnicodeDecodeError, ValueError, json.JSONDecodeError):
    raise SystemExit(1)
raise SystemExit(0)
PY
then
  exit "$driver_status"
fi

pinset="$('/opt/kor-travel-docker-manager/backend/.venv/bin/ktdctl' pin show --json | /usr/bin/python3 -I -S -c '
from __future__ import annotations
import json
import sys
value = json.load(sys.stdin)
pinset = value.get("pinset_sha256") if isinstance(value, dict) else None
if not isinstance(pinset, str) or len(pinset) != 64 or any(char not in "0123456789abcdef" for char in pinset):
    raise SystemExit(1)
print(pinset)
')"

# `pin block`은 이미 driver가 terminal 차단을 마친 경우에도 idempotent다. block 자체가
# 실패하면 실행권을 복원하지 않으며 launcher도 성공으로 보고하지 않는다.
/opt/kor-travel-docker-manager/backend/.venv/bin/ktdctl pin block "$pinset" \
  --reason 'M05 isolated launcher safe result unavailable' --confirm >/dev/null

fallback_path="$result_path"
if [[ -e "$fallback_path" ]]; then
  fallback_path="$output_dir/launcher-result.json"
fi
/usr/bin/python3 -I -S - "$fallback_path" "$expected_revision" "$pinset" <<'PY'
from __future__ import annotations

import json
import os
import pathlib
import stat
import sys

path = pathlib.Path(sys.argv[1])
revision = sys.argv[2]
pinset = sys.argv[3]
parent = path.parent.lstat()
if (
    path.is_absolute() is False
    or path.is_symlink()
    or not stat.S_ISDIR(parent.st_mode)
    or parent.st_uid != 0
    or stat.S_IMODE(parent.st_mode) != 0o700
):
    raise SystemExit(1)
payload = (
    json.dumps(
        {
            "cleanup_failed": True,
            "driver_phase": "launcher_safe_result_unavailable",
            "harness": "m05-isolated-bridge-v1",
            "manager_source_revision": revision,
            "phase": "launcher_safe_result_unavailable",
            "pinset_sha256": pinset,
            "status": "blocked",
        },
        ensure_ascii=True,
        separators=(",", ":"),
        sort_keys=True,
    )
    + "\n"
).encode("ascii")
flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
if hasattr(os, "O_NOFOLLOW"):
    flags |= os.O_NOFOLLOW
fd = os.open(path, flags, 0o600)
try:
    view = memoryview(payload)
    while view:
        written = os.write(fd, view)
        if written <= 0:
            raise SystemExit(1)
        view = view[written:]
    os.fsync(fd)
finally:
    os.close(fd)
metadata = path.lstat()
if (
    not stat.S_ISREG(metadata.st_mode)
    or metadata.st_uid != 0
    or stat.S_IMODE(metadata.st_mode) != 0o600
    or metadata.st_nlink != 1
):
    raise SystemExit(1)
directory = os.open(path.parent, os.O_RDONLY | os.O_CLOEXEC)
try:
    os.fsync(directory)
finally:
    os.close(directory)
PY

exit 1
