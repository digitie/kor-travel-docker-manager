#!/usr/bin/bash
set -euo pipefail

PATH="/usr/sbin:/usr/bin:/sbin:/bin"
export PATH

SOURCE_LAUNCHER="${1:-scripts/ktdctl-map-ui-auth-rotate}"
DEST_DIR="/usr/local/sbin"
DEST_PATH="${DEST_DIR}/ktdctl-map-ui-auth-rotate"
APP_ROOT="/opt/kor-travel-docker-manager"
TMP_PATH="${DEST_DIR}/.ktdctl-map-ui-auth-rotate.installing"

die() {
  echo "$1" >&2
  exit 126
}

require_root_owned_non_writable() {
  local path="$1"
  local kind="$2"
  if [[ -L "${path}" ]]; then
    die "trusted path must not be a symlink: ${path}"
  fi
  if [[ "${kind}" == "dir" && ! -d "${path}" ]]; then
    die "trusted path is not a directory: ${path}"
  fi
  if [[ "${kind}" == "file" && ! -f "${path}" ]]; then
    die "trusted path is not a file: ${path}"
  fi
  local uid mode links
  uid="$(/usr/bin/stat -c '%u' "${path}")"
  mode="$(/usr/bin/stat -c '%a' "${path}")"
  links="$(/usr/bin/stat -c '%h' "${path}")"
  if [[ "${uid}" != "0" ]]; then
    die "trusted path is not root-owned: ${path}"
  fi
  if (( (8#${mode} & 022) != 0 )); then
    die "trusted path is group/world writable: ${path}"
  fi
  if [[ "${kind}" == "file" && "${links}" != "1" ]]; then
    die "trusted file must not have hardlinks: ${path}"
  fi
}

require_trusted_python() {
  local path="$1"
  if [[ ! -e "${path}" ]]; then
    die "trusted Python is missing: ${path}"
  fi
  local current="${path}"
  local depth=0
  while [[ -L "${current}" ]]; do
    local uid target next
    uid="$(/usr/bin/stat -c '%u' "${current}")"
    if [[ "${uid}" != "0" ]]; then
      die "trusted Python symlink is not root-owned: ${current}"
    fi
    target="$(/usr/bin/readlink "${current}")"
    if [[ -z "${target}" ]]; then
      die "trusted Python symlink target is empty: ${current}"
    fi
    if [[ "${target}" = /* ]]; then
      next="${target}"
    else
      next="$(/usr/bin/dirname "${current}")/${target}"
    fi
    current="${next}"
    depth=$((depth + 1))
    if (( depth > 8 )); then
      die "trusted Python symlink chain is too deep"
    fi
  done
  local canonical
  canonical="$(/usr/bin/readlink -f "${path}")"
  if [[ ! "${canonical}" =~ ^/usr/bin/python3(\.[0-9]+)?$ ]]; then
    die "trusted Python must resolve to /usr/bin/python3.x"
  fi
  require_root_owned_non_writable "${canonical}" file
}

if [[ "$(/usr/bin/id -u)" != "0" ]]; then
  die "trusted launcher install must run as root"
fi
if [[ ! -f "${SOURCE_LAUNCHER}" ]]; then
  die "source launcher is missing"
fi

for trusted_dir in /usr /usr/local "${DEST_DIR}" /opt "${APP_ROOT}" "${APP_ROOT}/backend" \
  "${APP_ROOT}/backend/.venv" "${APP_ROOT}/backend/.venv/bin"; do
  require_root_owned_non_writable "${trusted_dir}" dir
done
for trusted_file in "${APP_ROOT}/.ktdm-source-revision" "${APP_ROOT}/.ktdm-release-manifest.json"; do
  require_root_owned_non_writable "${trusted_file}" file
done
require_root_owned_non_writable "${SOURCE_LAUNCHER}" file
require_trusted_python "${APP_ROOT}/backend/.venv/bin/python"
if [[ -e "${TMP_PATH}" || -L "${TMP_PATH}" ]]; then
  die "trusted launcher staging path already exists"
fi
if [[ -e "${DEST_PATH}" || -L "${DEST_PATH}" ]]; then
  require_root_owned_non_writable "${DEST_PATH}" file
  if [[ "$(/usr/bin/stat -c '%a' "${DEST_PATH}")" != "755" ]]; then
    die "existing trusted launcher mode is invalid"
  fi
fi

cleanup() {
  /usr/bin/rm -f "${TMP_PATH}"
}
trap cleanup EXIT

/usr/bin/install -o root -g root -m 0755 "${SOURCE_LAUNCHER}" "${TMP_PATH}"
expected_sha256="$(/usr/bin/sha256sum "${TMP_PATH}" | /usr/bin/cut -d ' ' -f 1)"
/usr/bin/python3 -I -S - "${TMP_PATH}" "${DEST_DIR}" <<'PY'
from __future__ import annotations

import os
import pathlib
import stat
import sys

tmp = pathlib.Path(sys.argv[1])
directory = pathlib.Path(sys.argv[2])
st = tmp.lstat()
if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_nlink != 1:
    raise SystemExit("staged launcher is not a root-owned regular file")
if stat.S_IMODE(st.st_mode) != 0o755:
    raise SystemExit("staged launcher mode is invalid")
with tmp.open("rb") as handle:
    os.fsync(handle.fileno())
fd = os.open(directory, os.O_RDONLY)
try:
    os.fsync(fd)
finally:
    os.close(fd)
PY
/usr/bin/mv -T -f "${TMP_PATH}" "${DEST_PATH}"
/usr/bin/python3 -I -S - "${DEST_PATH}" "${DEST_DIR}" "${expected_sha256}" <<'PY'
from __future__ import annotations

import hashlib
import os
import pathlib
import stat
import sys

destination = pathlib.Path(sys.argv[1])
directory = pathlib.Path(sys.argv[2])
expected_sha256 = sys.argv[3]
metadata = destination.lstat()
if (
    not stat.S_ISREG(metadata.st_mode)
    or metadata.st_uid != 0
    or metadata.st_nlink != 1
    or stat.S_IMODE(metadata.st_mode) != 0o755
    or hashlib.sha256(destination.read_bytes()).hexdigest() != expected_sha256
):
    raise SystemExit("installed trusted launcher evidence is invalid")
fd = os.open(directory, os.O_RDONLY)
try:
    os.fsync(fd)
finally:
    os.close(fd)
PY
trap - EXIT
