#!/usr/bin/bash
set -euo pipefail

PATH="/usr/sbin:/usr/bin:/sbin:/bin"
export PATH

ORIGINAL_ARGS=("$@")
APP_ROOT="/opt/kor-travel-docker-manager"
APP_PARENT="/opt"
SOURCE_ROOT=""
ENV_FILE=""
WHEELHOUSE="${KTDM_TRUSTED_RELEASE_WHEELHOUSE:-/var/lib/kor-travel-docker-manager/wheelhouse}"
STAGING="${APP_PARENT}/.kor-travel-docker-manager.stage.$$"
ROLLBACK="${APP_PARENT}/.kor-travel-docker-manager.rollback.$$"
ARCHIVE="${APP_PARENT}/.kor-travel-docker-manager.archive.$$.tar"
LAUNCHER_PATH="/usr/local/sbin/ktdctl-map-ui-auth-rotate"
LAUNCHER_ROLLBACK="/usr/local/sbin/.ktdctl-map-ui-auth-rotate.rollback.$$"
STATE_ROOT="/var/lib/kor-travel-docker-manager"
GLOBAL_LOCK_DIR="/run/lock/kor-travel-docker-manager"
GLOBAL_LOCK="${GLOBAL_LOCK_DIR}/global-mutation.lock"
ACTIVATED=0

die() {
  echo "$1" >&2
  exit 126
}

snapshot_env_file() {
  local path="$1"
  /usr/bin/python3 -I -S - "${path}" <<'PY'
from __future__ import annotations

import hashlib
import json
import os
import pathlib
import stat
import sys

path = pathlib.Path(sys.argv[1])
if not path.is_absolute() or path != path.resolve(strict=True):
    raise SystemExit("deployment .env path must be canonical and contain no symlinks")
flags = os.O_RDONLY | os.O_CLOEXEC
if hasattr(os, "O_NOFOLLOW"):
    flags |= os.O_NOFOLLOW
fd = os.open(path, flags)
try:
    before = os.fstat(fd)
    if (
        not stat.S_ISREG(before.st_mode)
        or before.st_nlink != 1
        or stat.S_IMODE(before.st_mode) != 0o600
    ):
        raise SystemExit("deployment .env evidence is invalid")
    digest = hashlib.sha256()
    while chunk := os.read(fd, 1024 * 1024):
        digest.update(chunk)
    after = os.fstat(fd)
finally:
    os.close(fd)
identity = (
    before.st_dev,
    before.st_ino,
    before.st_mode,
    before.st_uid,
    before.st_gid,
    before.st_nlink,
    before.st_size,
    before.st_mtime_ns,
    before.st_ctime_ns,
)
if identity != (
    after.st_dev,
    after.st_ino,
    after.st_mode,
    after.st_uid,
    after.st_gid,
    after.st_nlink,
    after.st_size,
    after.st_mtime_ns,
    after.st_ctime_ns,
):
    raise SystemExit("deployment .env changed while it was being captured")
print(
    json.dumps(
        {
            "dev": before.st_dev,
            "ino": before.st_ino,
            "mode": stat.S_IMODE(before.st_mode),
            "uid": before.st_uid,
            "gid": before.st_gid,
            "nlink": before.st_nlink,
            "size": before.st_size,
            "mtime_ns": before.st_mtime_ns,
            "ctime_ns": before.st_ctime_ns,
            "sha256": digest.hexdigest(),
        },
        sort_keys=True,
        separators=(",", ":"),
    )
)
PY
}

snapshot_env_fd() {
  local fd="$1"
  /usr/bin/python3 -I -S - "${fd}" <<'PY'
from __future__ import annotations

import fcntl
import hashlib
import json
import os
import stat
import sys

fd = int(sys.argv[1])
if fcntl.fcntl(fd, fcntl.F_GETFL) & os.O_ACCMODE != os.O_RDONLY:
    raise SystemExit("deployment .env descriptor is not read-only")
os.lseek(fd, 0, os.SEEK_SET)
before = os.fstat(fd)
if (
    not stat.S_ISREG(before.st_mode)
    or before.st_nlink != 1
    or stat.S_IMODE(before.st_mode) != 0o600
):
    raise SystemExit("deployment .env descriptor is invalid")
digest = hashlib.sha256()
while chunk := os.read(fd, 1024 * 1024):
    digest.update(chunk)
after = os.fstat(fd)
identity = (
    before.st_dev,
    before.st_ino,
    before.st_mode,
    before.st_uid,
    before.st_gid,
    before.st_nlink,
    before.st_size,
    before.st_mtime_ns,
    before.st_ctime_ns,
)
if identity != (
    after.st_dev,
    after.st_ino,
    after.st_mode,
    after.st_uid,
    after.st_gid,
    after.st_nlink,
    after.st_size,
    after.st_mtime_ns,
    after.st_ctime_ns,
):
    raise SystemExit("deployment .env descriptor changed while it was being captured")
print(
    json.dumps(
        {
            "dev": before.st_dev,
            "ino": before.st_ino,
            "mode": stat.S_IMODE(before.st_mode),
            "uid": before.st_uid,
            "gid": before.st_gid,
            "nlink": before.st_nlink,
            "size": before.st_size,
            "mtime_ns": before.st_mtime_ns,
            "ctime_ns": before.st_ctime_ns,
            "sha256": digest.hexdigest(),
        },
        sort_keys=True,
        separators=(",", ":"),
    )
)
PY
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --env-file)
      shift
      [[ "$#" -gt 0 ]] || die "--env-file requires a path"
      ENV_FILE="$1"
      ;;
    --wheelhouse)
      shift
      [[ "$#" -gt 0 ]] || die "--wheelhouse requires a path"
      WHEELHOUSE="$1"
      ;;
    --help|-h)
      echo "usage: install-ktdm-trusted-release [--env-file PATH] [--wheelhouse ROOT_OWNED_WHEELHOUSE] [SOURCE_ROOT]"
      echo "default wheelhouse: /var/lib/kor-travel-docker-manager/wheelhouse"
      exit 0
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      [[ -z "${SOURCE_ROOT}" ]] || die "source checkout was provided more than once"
      SOURCE_ROOT="$1"
      ;;
  esac
  shift
done

SOURCE_ROOT="${SOURCE_ROOT:-$PWD}"
if [[ -z "${ENV_FILE}" ]]; then
  ENV_FILE="${APP_ROOT}/.env"
fi

if [[ "$(/usr/bin/id -u)" != "0" ]]; then
  die "trusted release install must run as root"
fi
if [[ ! -d "${SOURCE_ROOT}" ]]; then
  die "source checkout is missing"
fi
if [[ ! -d "${WHEELHOUSE}" ]]; then
  die "trusted offline wheelhouse is missing"
fi
if [[ ! -f "${ENV_FILE}" ]]; then
  die "deployment .env evidence is missing"
fi

ENV_FILE_SNAPSHOT_BEFORE_LOCK="$(snapshot_env_file "${ENV_FILE}")"
if [[ -z "${KTDM_TRUSTED_INSTALL_GLOBAL_LOCK_FD:-}" ]]; then
  export KTDM_TRUSTED_INSTALL_EXPECTED_ENV_SNAPSHOT="${ENV_FILE_SNAPSHOT_BEFORE_LOCK}"
  exec /usr/bin/python3 -I -S - "${BASH_SOURCE[0]}" "${ENV_FILE}" "${ORIGINAL_ARGS[@]}" <<'PY'
from __future__ import annotations

import fcntl
import hashlib
import json
import os
import pathlib
import stat
import sys

script = pathlib.Path(sys.argv[1]).resolve(strict=True)
env_path = pathlib.Path(sys.argv[2])
arguments = sys.argv[3:]
expected_env_snapshot = os.environ.get(
    "KTDM_TRUSTED_INSTALL_EXPECTED_ENV_SNAPSHOT",
    "",
)
lock_dir = pathlib.Path("/run/lock/kor-travel-docker-manager")
lock_path = lock_dir / "global-mutation.lock"
lock_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
directory_stat = lock_dir.lstat()
if (
    not stat.S_ISDIR(directory_stat.st_mode)
    or directory_stat.st_uid != 0
    or stat.S_IMODE(directory_stat.st_mode) != 0o700
):
    raise SystemExit("production global mutation lock directory is unsafe")
flags = os.O_CREAT | os.O_RDWR | os.O_CLOEXEC
if hasattr(os, "O_NOFOLLOW"):
    flags |= os.O_NOFOLLOW
fd = os.open(lock_path, flags, 0o600)
lock_stat = os.fstat(fd)
if (
    not stat.S_ISREG(lock_stat.st_mode)
    or lock_stat.st_nlink != 1
    or lock_stat.st_uid != 0
    or stat.S_IMODE(lock_stat.st_mode) != 0o600
):
    os.close(fd)
    raise SystemExit("production global mutation lock is unsafe")
try:
    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError as exc:
    os.close(fd)
    raise SystemExit("another manager mutation is already active") from exc
if not env_path.is_absolute() or env_path != env_path.resolve(strict=True):
    os.close(fd)
    raise SystemExit("deployment .env path must be canonical and contain no symlinks")
env_flags = os.O_RDONLY | os.O_CLOEXEC
if hasattr(os, "O_NOFOLLOW"):
    env_flags |= os.O_NOFOLLOW
env_fd = os.open(env_path, env_flags)
env_before = os.fstat(env_fd)
if (
    not stat.S_ISREG(env_before.st_mode)
    or env_before.st_nlink != 1
    or stat.S_IMODE(env_before.st_mode) != 0o600
):
    os.close(env_fd)
    os.close(fd)
    raise SystemExit("deployment .env evidence is invalid")
env_digest = hashlib.sha256()
while chunk := os.read(env_fd, 1024 * 1024):
    env_digest.update(chunk)
env_after = os.fstat(env_fd)
env_snapshot = json.dumps(
    {
        "dev": env_before.st_dev,
        "ino": env_before.st_ino,
        "mode": stat.S_IMODE(env_before.st_mode),
        "uid": env_before.st_uid,
        "gid": env_before.st_gid,
        "nlink": env_before.st_nlink,
        "size": env_before.st_size,
        "mtime_ns": env_before.st_mtime_ns,
        "ctime_ns": env_before.st_ctime_ns,
        "sha256": env_digest.hexdigest(),
    },
    sort_keys=True,
    separators=(",", ":"),
)
if (
    env_before.st_dev,
    env_before.st_ino,
    env_before.st_mode,
    env_before.st_uid,
    env_before.st_gid,
    env_before.st_nlink,
    env_before.st_size,
    env_before.st_mtime_ns,
    env_before.st_ctime_ns,
) != (
    env_after.st_dev,
    env_after.st_ino,
    env_after.st_mode,
    env_after.st_uid,
    env_after.st_gid,
    env_after.st_nlink,
    env_after.st_size,
    env_after.st_mtime_ns,
    env_after.st_ctime_ns,
):
    os.close(env_fd)
    os.close(fd)
    raise SystemExit("deployment .env changed while it was being captured")
if env_snapshot != expected_env_snapshot:
    os.close(env_fd)
    os.close(fd)
    raise SystemExit("deployment .env changed before trusted installer lock acquisition")
os.set_inheritable(fd, True)
os.set_inheritable(env_fd, True)
environment = dict(os.environ)
environment["KTDM_TRUSTED_INSTALL_GLOBAL_LOCK_FD"] = str(fd)
environment["KTDM_TRUSTED_INSTALL_ENV_FD"] = str(env_fd)
os.execve("/usr/bin/bash", ["/usr/bin/bash", str(script), *arguments], environment)
PY
fi

lock_fd="${KTDM_TRUSTED_INSTALL_GLOBAL_LOCK_FD}"
env_fd="${KTDM_TRUSTED_INSTALL_ENV_FD:-}"
if [[ ! "${lock_fd}" =~ ^[0-9]+$ || ! "${env_fd}" =~ ^[0-9]+$ ]]; then
  die "trusted installer descriptor evidence is invalid"
fi
/usr/bin/python3 -I -S - "${lock_fd}" "${GLOBAL_LOCK}" <<'PY'
from __future__ import annotations

import fcntl
import os
import pathlib
import stat
import sys

fd = int(sys.argv[1])
path = pathlib.Path(sys.argv[2])
descriptor_stat = os.fstat(fd)
path_stat = path.lstat()
if (
    (descriptor_stat.st_dev, descriptor_stat.st_ino)
    != (path_stat.st_dev, path_stat.st_ino)
    or not stat.S_ISREG(descriptor_stat.st_mode)
    or descriptor_stat.st_nlink != 1
    or descriptor_stat.st_uid != 0
    or stat.S_IMODE(descriptor_stat.st_mode) != 0o600
):
    raise SystemExit("production global mutation lock descriptor is unsafe")
try:
    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError as exc:
    raise SystemExit("production global mutation lock is not held") from exc
PY
unset KTDM_TRUSTED_INSTALL_GLOBAL_LOCK_FD

expected_env_snapshot="${KTDM_TRUSTED_INSTALL_EXPECTED_ENV_SNAPSHOT:-}"
ENV_FILE_SNAPSHOT_AFTER_LOCK="$(snapshot_env_file "${ENV_FILE}")"
ENV_FD_SNAPSHOT_AFTER_LOCK="$(snapshot_env_fd "${env_fd}")"
if (
  [[ "${ENV_FILE_SNAPSHOT_AFTER_LOCK}" != "${expected_env_snapshot}" ]] ||
  [[ "${ENV_FD_SNAPSHOT_AFTER_LOCK}" != "${expected_env_snapshot}" ]]
); then
  die "deployment .env changed before trusted installer lock acquisition"
fi
unset KTDM_TRUSTED_INSTALL_EXPECTED_ENV_SNAPSHOT KTDM_TRUSTED_INSTALL_ENV_FD

/usr/bin/install -d -o root -g root -m 0700 "${STATE_ROOT}"

source_uid="$(/usr/bin/stat -c '%u' "${SOURCE_ROOT}")"
source_gid="$(/usr/bin/stat -c '%g' "${SOURCE_ROOT}")"
env_uid="$(/usr/bin/python3 -I -S -c 'import json,sys; print(json.loads(sys.argv[1])["uid"])' "${expected_env_snapshot}")"
env_gid="$(/usr/bin/python3 -I -S -c 'import json,sys; print(json.loads(sys.argv[1])["gid"])' "${expected_env_snapshot}")"

require_root_locked_dir() {
  local path="$1"
  if [[ -L "${path}" || ! -d "${path}" ]]; then
    die "trusted directory is not a real directory: ${path}"
  fi
  local uid mode
  uid="$(/usr/bin/stat -c '%u' "${path}")"
  mode="$(/usr/bin/stat -c '%a' "${path}")"
  if [[ "${uid}" != "0" || $((8#${mode} & 022)) != "0" ]]; then
    die "trusted directory is writable or not root-owned: ${path}"
  fi
}

snapshot_wheelhouse() {
  local path="$1"
  /usr/bin/python3 -I -S - "${path}" <<'PY'
from __future__ import annotations

import hashlib
import json
import pathlib
import stat
import sys

raw = pathlib.Path(sys.argv[1])
absolute = raw if raw.is_absolute() else pathlib.Path.cwd() / raw
current = pathlib.Path(absolute.anchor)
for part in absolute.parts[1:]:
    current = current / part
    try:
        st = current.lstat()
    except OSError as exc:
        raise SystemExit(f"wheelhouse path component is unavailable: {current}") from exc
    if stat.S_ISLNK(st.st_mode):
        raise SystemExit(f"wheelhouse path component must not be a symlink: {current}")

root = absolute.resolve(strict=True)
for ancestor in (root, *root.parents):
    st = ancestor.lstat()
    if (
        not stat.S_ISDIR(st.st_mode)
        or st.st_uid != 0
        or (stat.S_IMODE(st.st_mode) & 0o022)
    ):
        raise SystemExit(f"wheelhouse ancestor is writable or not root-owned: {ancestor}")

wheels = []
for wheel in sorted(root.glob("*.whl")):
    st = wheel.lstat()
    if (
        not stat.S_ISREG(st.st_mode)
        or st.st_uid != 0
        or st.st_nlink != 1
        or (stat.S_IMODE(st.st_mode) & 0o022)
    ):
        raise SystemExit(f"wheelhouse wheel is unsafe: {wheel}")
    wheels.append(
        {
            "name": wheel.name,
            "sha256": hashlib.sha256(wheel.read_bytes()).hexdigest(),
            "size": st.st_size,
            "dev": st.st_dev,
            "ino": st.st_ino,
            "mode": stat.S_IMODE(st.st_mode),
            "uid": st.st_uid,
            "gid": st.st_gid,
            "nlink": st.st_nlink,
        }
    )
if not wheels:
    raise SystemExit("trusted offline wheelhouse has no wheels")
print(json.dumps({"root": str(root), "wheels": wheels}, sort_keys=True, separators=(",", ":")))
PY
}

verify_wheelhouse_snapshot() {
  local path="$1"
  local expected="$2"
  local actual
  actual="$(snapshot_wheelhouse "${path}")"
  if [[ "${actual}" != "${expected}" ]]; then
    die "trusted offline wheelhouse changed during root pip execution"
  fi
}

require_root_locked_dir "${WHEELHOUSE}"
WHEELHOUSE_SNAPSHOT="$(snapshot_wheelhouse "${WHEELHOUSE}")"

run_source_git() {
  /usr/bin/sudo -H -u "#${source_uid}" -- /usr/bin/git -C "${SOURCE_ROOT}" "$@"
}

revision="$(run_source_git rev-parse HEAD)"
if [[ ! "${revision}" =~ ^[0-9a-f]{40}$ ]]; then
  die "source revision is invalid"
fi
if ! run_source_git diff-index --quiet "${revision}" --; then
  die "source checkout must be clean before trusted release install"
fi
run_source_git archive --format=tar "${revision}" > "${ARCHIVE}"
/usr/bin/chown root:root "${ARCHIVE}"
/usr/bin/chmod 0600 "${ARCHIVE}"

cleanup() {
  set +e
  /usr/bin/rm -rf "${STAGING}" "${ARCHIVE}"
  if [[ "${ACTIVATED}" == "1" && -d "${APP_ROOT}" ]]; then
    /usr/bin/rm -rf "${APP_ROOT}"
  fi
  if [[ -d "${ROLLBACK}" && ! -d "${APP_ROOT}" ]]; then
    if ! /usr/bin/mv -T "${ROLLBACK}" "${APP_ROOT}"; then
      echo "failed to restore previous app root; rollback residue preserved at ${ROLLBACK}" >&2
    fi
  elif [[ -d "${ROLLBACK}" ]]; then
    echo "active app root still exists; rollback residue preserved at ${ROLLBACK}" >&2
  fi
  if [[ -e "${LAUNCHER_ROLLBACK}" ]]; then
    if ! /usr/bin/mv -f "${LAUNCHER_ROLLBACK}" "${LAUNCHER_PATH}"; then
      echo "failed to restore previous launcher; rollback residue preserved at ${LAUNCHER_ROLLBACK}" >&2
    fi
  elif [[ "${ACTIVATED}" == "1" ]]; then
    /usr/bin/rm -f "${LAUNCHER_PATH}"
  fi
}
trap cleanup EXIT

/usr/bin/install -d -o root -g root -m 0700 "${STAGING}"
/usr/bin/tar -x -f "${ARCHIVE}" -C "${STAGING}"
/usr/bin/chown -R root:root "${STAGING}"
/usr/bin/find "${STAGING}" -type d -exec /usr/bin/chmod 0755 {} +
/usr/bin/find "${STAGING}" -type f -exec /usr/bin/chmod 0644 {} +
/usr/bin/chmod 0700 "${STAGING}"
/usr/bin/chmod 0755 "${STAGING}/scripts/ktdctl-map-ui-auth-rotate" \
  "${STAGING}/scripts/install-ktdctl-map-ui-auth-rotate" \
  "${STAGING}/scripts/install-ktdm-trusted-release"

/usr/bin/printf '%s\n' "${revision}" > "${STAGING}/.ktdm-source-revision"
/usr/bin/chown root:root "${STAGING}/.ktdm-source-revision"
/usr/bin/chmod 0644 "${STAGING}/.ktdm-source-revision"

/usr/bin/python3 -m venv "${STAGING}/backend/.venv"
/usr/bin/install -d -o root -g root -m 0755 "${STAGING}/.wheelhouse"
verify_wheelhouse_snapshot "${WHEELHOUSE}" "${WHEELHOUSE_SNAPSHOT}"
"${STAGING}/backend/.venv/bin/python" -I -m pip wheel \
  --no-index \
  --find-links "${WHEELHOUSE}" \
  --wheel-dir "${STAGING}/.wheelhouse" \
  "${STAGING}/backend"
verify_wheelhouse_snapshot "${WHEELHOUSE}" "${WHEELHOUSE_SNAPSHOT}"
shopt -s nullglob
built_backend_wheels=("${STAGING}"/.wheelhouse/kor_travel_docker_manager_backend-*.whl)
shopt -u nullglob
if [[ "${#built_backend_wheels[@]}" != "1" ]]; then
  die "trusted release build must produce exactly one manager backend wheel"
fi
verify_wheelhouse_snapshot "${WHEELHOUSE}" "${WHEELHOUSE_SNAPSHOT}"
"${STAGING}/backend/.venv/bin/python" -I -m pip install \
  --no-index \
  --find-links "${WHEELHOUSE}" \
  --find-links "${STAGING}/.wheelhouse" \
  "${built_backend_wheels[0]}"
verify_wheelhouse_snapshot "${WHEELHOUSE}" "${WHEELHOUSE_SNAPSHOT}"

/usr/bin/python3 -I -S - "${STAGING}" "${APP_ROOT}" <<'PY'
from __future__ import annotations

import base64
import csv
import hashlib
import io
import pathlib
import sys

staging = pathlib.Path(sys.argv[1]).resolve(strict=True)
app_root = pathlib.Path(sys.argv[2])
site_packages_candidates = list(
    (staging / "backend" / ".venv" / "lib").glob("python*/site-packages")
)
if len(site_packages_candidates) != 1:
    raise SystemExit("trusted release site-packages is ambiguous")
site_packages = site_packages_candidates[0]
dist_infos = list(
    site_packages.glob("kor_travel_docker_manager_backend-*.dist-info")
)
if len(dist_infos) != 1:
    raise SystemExit("trusted release dist-info is ambiguous")
record = dist_infos[0] / "RECORD"
entrypoint = staging / "backend" / ".venv" / "bin" / "ktdctl"
payload = entrypoint.read_bytes()
lines = payload.splitlines(keepends=True)
expected_shebang = f"#!{staging}/backend/.venv/bin/python".encode("utf-8")
if not lines or lines[0].rstrip(b"\r\n") != expected_shebang:
    raise SystemExit("trusted release entrypoint shebang is unexpected")
rewritten = (
    f"#!{app_root}/backend/.venv/bin/python\n"
    "import os\n"
    "import sys\n"
    f'os.environ["KOR_TRAVEL_DOCKER_MANAGER_PROJECT_ROOT"] = "{app_root}"\n'
    "from kor_travel_docker_manager.cli import main\n"
    'if __name__ == "__main__":\n'
    "    raise SystemExit(main())\n"
).encode("utf-8")
entrypoint.write_bytes(rewritten)

rows = list(csv.reader(record.read_text(encoding="utf-8").splitlines()))
entrypoint_rows = 0
for row in rows:
    if len(row) < 3:
        raise SystemExit("wheel RECORD row is invalid")
    target = (site_packages / row[0]).resolve(strict=True)
    if target != entrypoint:
        continue
    entrypoint_rows += 1
    encoded = base64.urlsafe_b64encode(hashlib.sha256(rewritten).digest()).rstrip(b"=")
    row[1] = f"sha256={encoded.decode('ascii')}"
    row[2] = str(len(rewritten))
if entrypoint_rows != 1:
    raise SystemExit("wheel RECORD must contain exactly one manager entrypoint")
output = io.StringIO(newline="")
writer = csv.writer(output, lineterminator="\n")
writer.writerows(rows)
record.write_text(output.getvalue(), encoding="utf-8")
PY

KTDM_SOURCE_OWNER_UID="${source_uid}" \
KTDM_SOURCE_OWNER_GID="${source_gid}" \
KTDM_ENV_OWNER_UID="${env_uid}" \
KTDM_ENV_OWNER_GID="${env_gid}" \
KTDM_WHEELHOUSE="${WHEELHOUSE}" \
KTDM_BUILT_BACKEND_WHEEL="${built_backend_wheels[0]}" \
/usr/bin/python3 -I -S - "${STAGING}" "${revision}" <<'PY'
from __future__ import annotations

import base64
import csv
import hashlib
import json
import os
import pathlib
import stat
import sys
from datetime import UTC, datetime

root = pathlib.Path(sys.argv[1]).resolve(strict=True)
revision = sys.argv[2]
env_uid = int(os.environ["KTDM_ENV_OWNER_UID"])
env_gid = int(os.environ["KTDM_ENV_OWNER_GID"])
wheelhouse = pathlib.Path(os.environ["KTDM_WHEELHOUSE"]).resolve(strict=True)
built_backend_wheel = pathlib.Path(os.environ["KTDM_BUILT_BACKEND_WHEEL"]).resolve(strict=True)
site_packages_candidates = list((root / "backend" / ".venv" / "lib").glob(
    "python*/site-packages"
))
if len(site_packages_candidates) != 1:
    raise SystemExit("trusted release site-packages is ambiguous")
site_packages = site_packages_candidates[0]
package_dir = site_packages / "kor_travel_docker_manager"
dist_infos = list(site_packages.glob("kor_travel_docker_manager_backend-*.dist-info"))
if len(dist_infos) != 1:
    raise SystemExit("trusted release dist-info is ambiguous")
dist_info = dist_infos[0]
record = dist_info / "RECORD"
venv_root = site_packages.parent.parent.parent
expected_entrypoint = venv_root / "bin" / "ktdctl"

def assert_root_locked(path: pathlib.Path, *, regular_file: bool = False) -> None:
    st = path.lstat()
    if stat.S_ISLNK(st.st_mode):
        raise SystemExit(f"trusted release path is a symlink: {path}")
    if regular_file and not stat.S_ISREG(st.st_mode):
        raise SystemExit(f"trusted release path is not a regular file: {path}")
    if st.st_uid != 0 or (stat.S_IMODE(st.st_mode) & 0o022):
        raise SystemExit(f"trusted release path is writable or not root-owned: {path}")
    if stat.S_ISREG(st.st_mode) and st.st_nlink != 1:
        raise SystemExit(f"trusted release file has hardlinks: {path}")

for required in (
    root,
    root / "docker-compose.yml",
    root / ".ktdm-source-revision",
    site_packages,
    package_dir,
    dist_info,
    record,
    wheelhouse,
    built_backend_wheel,
):
    assert_root_locked(
        required,
        regular_file=required in {
            root / "docker-compose.yml",
            root / ".ktdm-source-revision",
            record,
            built_backend_wheel,
        },
    )

wheelhouse_hash = hashlib.sha256()
for wheel in sorted(wheelhouse.glob("*.whl")):
    assert_root_locked(wheel, regular_file=True)
    wheelhouse_hash.update(wheel.name.encode("utf-8") + b"\0")
    wheelhouse_hash.update(hashlib.sha256(wheel.read_bytes()).hexdigest().encode("ascii"))
    wheelhouse_hash.update(b"\0")

record_hash = hashlib.sha256(record.read_bytes()).hexdigest()
package_files = 0
with record.open(newline="", encoding="utf-8") as handle:
    for row in csv.reader(handle):
        if len(row) < 3:
            raise SystemExit("wheel RECORD row is invalid")
        relative, digest, _size = row[:3]
        target = (site_packages / relative).resolve(strict=True)
        try:
            target.relative_to(site_packages)
        except ValueError as exc:
            if target != expected_entrypoint:
                raise SystemExit("wheel RECORD escapes site-packages") from exc
        assert_root_locked(target)
        if package_dir == target or package_dir in target.parents:
            package_files += 1
        if digest:
            algorithm, separator, encoded = digest.partition("=")
            if separator != "=" or algorithm != "sha256":
                raise SystemExit("wheel RECORD digest must be sha256")
            actual = hashlib.sha256(target.read_bytes()).digest()
            expected = base64.urlsafe_b64decode(
                encoded + "=" * (-len(encoded) % 4)
            )
            if actual != expected:
                raise SystemExit(f"wheel RECORD digest mismatch: {relative}")
if package_files == 0:
    raise SystemExit("wheel RECORD does not cover manager package")

manifest = {
    "manager_source_revision": revision,
    "installed_at": datetime.now(UTC).isoformat(),
    "source_owner_uid": int(os.environ["KTDM_SOURCE_OWNER_UID"]),
    "source_owner_gid": int(os.environ["KTDM_SOURCE_OWNER_GID"]),
    "env_owner_uid": env_uid,
    "env_owner_gid": env_gid,
    "backend_distribution": dist_info.name,
    "backend_wheel_sha256": hashlib.sha256(built_backend_wheel.read_bytes()).hexdigest(),
    "wheel_record_sha256": record_hash,
    "wheelhouse_sha256": wheelhouse_hash.hexdigest(),
}
(root / ".ktdm-release-manifest.json").write_text(
    json.dumps(manifest, sort_keys=True) + "\n",
    encoding="utf-8",
)
os.chown(root / ".ktdm-release-manifest.json", 0, 0)
os.chmod(root / ".ktdm-release-manifest.json", 0o644)
PY

/usr/bin/python3 -I -S - "${STAGING}" <<'PY'
from __future__ import annotations

import os
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
seen: set[pathlib.Path] = set()
for path in (
    root,
    root / ".ktdm-source-revision",
    root / ".ktdm-release-manifest.json",
    root / "docker-compose.yml",
    root / "backend" / ".venv",
):
    directory = path if path.is_dir() else path.parent
    if directory in seen:
        continue
    seen.add(directory)
    fd = os.open(directory, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)
PY

ENV_FILE_SNAPSHOT_BEFORE_COPY="$(snapshot_env_file "${ENV_FILE}")"
ENV_FD_SNAPSHOT_BEFORE_COPY="$(snapshot_env_fd "${env_fd}")"
if (
  [[ "${ENV_FILE_SNAPSHOT_BEFORE_COPY}" != "${expected_env_snapshot}" ]] ||
  [[ "${ENV_FD_SNAPSHOT_BEFORE_COPY}" != "${expected_env_snapshot}" ]]
); then
  die "deployment .env changed before trusted release staging"
fi

/usr/bin/python3 -I -S - \
  "${env_fd}" \
  "${STAGING}/.env" \
  "${env_uid}" \
  "${env_gid}" \
  "${expected_env_snapshot}" <<'PY'
from __future__ import annotations

import hashlib
import json
import os
import pathlib
import stat
import sys

source_fd = int(sys.argv[1])
destination = pathlib.Path(sys.argv[2])
env_uid = int(sys.argv[3])
env_gid = int(sys.argv[4])
expected = json.loads(sys.argv[5])
parent_stat = destination.parent.lstat()
if (
    not stat.S_ISDIR(parent_stat.st_mode)
    or parent_stat.st_uid != 0
    or stat.S_IMODE(parent_stat.st_mode) != 0o700
):
    raise SystemExit("trusted release staging root is unsafe")
before = os.fstat(source_fd)
os.lseek(source_fd, 0, os.SEEK_SET)
flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_CLOEXEC
if hasattr(os, "O_NOFOLLOW"):
    flags |= os.O_NOFOLLOW
destination_fd = os.open(destination, flags, 0o600)
digest = hashlib.sha256()
size = 0
try:
    os.fchown(destination_fd, env_uid, env_gid)
    os.fchmod(destination_fd, 0o600)
    while chunk := os.read(source_fd, 1024 * 1024):
        digest.update(chunk)
        size += len(chunk)
        view = memoryview(chunk)
        while view:
            written = os.write(destination_fd, view)
            if written <= 0:
                raise SystemExit("deployment .env staging write made no progress")
            view = view[written:]
    os.fsync(destination_fd)
    destination_stat = os.fstat(destination_fd)
finally:
    os.close(destination_fd)
after = os.fstat(source_fd)
actual = {
    "dev": before.st_dev,
    "ino": before.st_ino,
    "mode": stat.S_IMODE(before.st_mode),
    "uid": before.st_uid,
    "gid": before.st_gid,
    "nlink": before.st_nlink,
    "size": before.st_size,
    "mtime_ns": before.st_mtime_ns,
    "ctime_ns": before.st_ctime_ns,
    "sha256": digest.hexdigest(),
}
if actual != expected or (
    before.st_dev,
    before.st_ino,
    before.st_mode,
    before.st_uid,
    before.st_gid,
    before.st_nlink,
    before.st_size,
    before.st_mtime_ns,
    before.st_ctime_ns,
) != (
    after.st_dev,
    after.st_ino,
    after.st_mode,
    after.st_uid,
    after.st_gid,
    after.st_nlink,
    after.st_size,
    after.st_mtime_ns,
    after.st_ctime_ns,
):
    raise SystemExit("deployment .env descriptor changed during staging")
if (
    not stat.S_ISREG(destination_stat.st_mode)
    or destination_stat.st_uid != env_uid
    or destination_stat.st_gid != env_gid
    or destination_stat.st_nlink != 1
    or stat.S_IMODE(destination_stat.st_mode) != 0o600
    or destination_stat.st_size != size
):
    raise SystemExit("staged deployment .env evidence is invalid")
directory_fd = os.open(destination.parent, os.O_RDONLY | os.O_CLOEXEC)
try:
    os.fsync(directory_fd)
finally:
    os.close(directory_fd)
PY

ENV_FILE_SNAPSHOT_AFTER_COPY="$(snapshot_env_file "${ENV_FILE}")"
ENV_FD_SNAPSHOT_AFTER_COPY="$(snapshot_env_fd "${env_fd}")"
if (
  [[ "${ENV_FILE_SNAPSHOT_AFTER_COPY}" != "${expected_env_snapshot}" ]] ||
  [[ "${ENV_FD_SNAPSHOT_AFTER_COPY}" != "${expected_env_snapshot}" ]]
); then
  die "deployment .env changed during trusted release staging"
fi

if [[ -e "${ROLLBACK}" ]]; then
  die "rollback staging path already exists"
fi
if [[ -e "${APP_ROOT}" ]]; then
  /usr/bin/mv -T "${APP_ROOT}" "${ROLLBACK}"
fi
if [[ -e "${LAUNCHER_PATH}" ]]; then
  /usr/bin/cp -a "${LAUNCHER_PATH}" "${LAUNCHER_ROLLBACK}"
fi
ACTIVATED=1
/usr/bin/mv -T "${STAGING}" "${APP_ROOT}"
/usr/bin/chmod 0755 "${APP_ROOT}"
INSTALLED_ENV_SNAPSHOT="$(snapshot_env_file "${APP_ROOT}/.env")"
/usr/bin/python3 -I -S - \
  "${expected_env_snapshot}" \
  "${INSTALLED_ENV_SNAPSHOT}" <<'PY'
from __future__ import annotations

import json
import sys

expected = json.loads(sys.argv[1])
installed = json.loads(sys.argv[2])
copy_contract = ("mode", "uid", "gid", "nlink", "size", "sha256")
if any(installed[key] != expected[key] for key in copy_contract):
    raise SystemExit("installed deployment .env does not match validated evidence")
PY
/usr/bin/python3 - <<'PY'
from __future__ import annotations

import os

fd = os.open("/opt", os.O_RDONLY)
try:
    os.fsync(fd)
finally:
    os.close(fd)
PY

"${APP_ROOT}/scripts/install-ktdctl-map-ui-auth-rotate" "${APP_ROOT}/scripts/ktdctl-map-ui-auth-rotate"
/usr/local/sbin/ktdctl-map-ui-auth-rotate --help >/dev/null

trap - EXIT
ACTIVATED=0
if ! /usr/bin/rm -rf "${ROLLBACK}" "${ARCHIVE}" "${LAUNCHER_ROLLBACK}"; then
  echo "trusted release committed; post-commit cleanup requires attention" >&2
fi
