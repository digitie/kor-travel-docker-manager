#!/usr/bin/bash
# Manager trusted release installer (ADR-51 D).
#
# 정확한 커밋 하나를 `/opt/ktdm-release-<sha>/`로 만들고 설치 root
# `/opt/kor-travel-docker-manager`(상대 symlink)를 그쪽으로 넘긴다. release는 root 소유 source
# clone의 `git archive <sha>`, venv는 오프라인 wheelhouse로 만든다. 배포 `.env`는 앞으로
# 복사하고, 백엔드는 항상 stop → flip → start 한다. 직전 release 하나를 남긴다.
#
# 복구 상태기계는 없다. revision 표식(`.ktdm-source-revision`)은 마지막에 쓰므로 표식 없는
# release는 미완이고 처음부터 다시 만든다 — 같은 sha를 다시 돌리는 것이 복구다. flip 전에
# 죽으면 설치 root와 도는 backend는 그대로다(단 /etc의 유닛은 이미 새 release의 것일 수 있다).
# 롤백은 옛 sha를 다시 설치하는 것이다. 손으로 symlink를 넘기지 않는다 — 옛 release의 `.env`
# 사본에는 옛 비밀·관리자 해시가 들어 있다.
#
# usage: install-ktdm-trusted-release --expected-source-revision SHA [--wheelhouse DIR] [SOURCE_CLONE]
#   SOURCE_CLONE은 root 소유 clone이다(기본값은 현재 디렉터리). --restart-backend·--allow-live는
#   받되 무시한다(백엔드는 항상 재기동한다).
set -euo pipefail
umask 022
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

APP=/opt/kor-travel-docker-manager
STATE_ROOT=/var/lib/kor-travel-docker-manager
REQUEST_ROOT=/var/lib/kor-travel-docker-manager-requests
LOCK_DIR=/run/lock/kor-travel-docker-manager
LOCK="${LOCK_DIR}/global-mutation.lock"
WHEELHOUSE="${KTDM_TRUSTED_RELEASE_WHEELHOUSE:-/var/lib/kor-travel-docker-manager/wheelhouse}"
SHA=""
SRC=""
die() { echo "$1" >&2; exit 126; }

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --expected-source-revision) [[ "$#" -ge 2 ]] || die "$1 requires a value"; SHA="$2"; shift ;;
    --wheelhouse) [[ "$#" -ge 2 ]] || die "$1 requires a value"; WHEELHOUSE="$2"; shift ;;
    --restart-backend|--allow-live) ;;
    -h|--help) awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "${BASH_SOURCE[0]}"; exit 0 ;;
    -*) die "unknown option: $1" ;;
    *) [[ -z "${SRC}" ]] || die "source clone was given more than once"; SRC="$1" ;;
  esac
  shift
done
[[ "${SHA}" =~ ^[0-9a-f]{40}$ ]] || die "--expected-source-revision must be a full 40-hex revision"
[[ "$(id -u)" == "0" ]] || die "trusted release install must run as root"
SRC="$(cd -- "${SRC:-${PWD}}" 2>/dev/null && pwd -P)" || die "source clone is missing"
# 아래는 cwd에 의존하지 않는다 — root python이 운영자 디렉터리의 모듈을 import하지 않게 한다.
cd /
# root가 실행하는 코드와 archive가 다른 계정의 쓰기 아래에 있으면 그 계정이 다음 설치를 가져간다.
[[ -e "${SRC}/.git" && "$(stat -c '%u' "${SRC}")" == "0" ]] \
  || die "source clone must be a root-owned git clone (docs/prod-deployment.md §3): ${SRC}"
[[ -L "${APP}" ]] || die "${APP} is not a release symlink; see docs/prod-deployment.md §3.0"
# wheelhouse는 root pip이 먹는 유일한 비git 입력이다. 다른 주체가 wheel을 넣을 수 없어야 한다.
[[ -d "${WHEELHOUSE}" && ! -L "${WHEELHOUSE}" ]] || die "offline wheelhouse is missing: ${WHEELHOUSE}"
[[ -z "$(find "${WHEELHOUSE}" \( ! -uid 0 -o -perm /022 \) -print -quit)" ]] \
  || die "offline wheelhouse has entries not owned by root or writable by others: ${WHEELHOUSE}"

# >>> G — Manager의 host 변경 lock(ADR-51 C). 이 프로세스가 끝날 때까지 쥔다.
[[ ! -L "${LOCK_DIR}" ]] || die "global mutation lock directory is a symlink: ${LOCK_DIR}"
install -d -o root -g root -m 0700 "${LOCK_DIR}"
[[ ! -L "${LOCK}" && ( ! -e "${LOCK}" || -f "${LOCK}" ) ]] || die "global mutation lock is not a regular file: ${LOCK}"
# 없던 lock 파일은 0600으로 만들어야 한다 — 다른 획득자가 0600·nlink 1을 요구한다.
umask 077
exec 9>>"${LOCK}"
umask 022
[[ "$(stat -c '%u:%a:%h' "${LOCK}")" == "0:600:1" ]] || die "global mutation lock is unsafe: ${LOCK}"
flock -n 9 || { echo "another manager mutation is already active" >&2; exit 2; }
# <<< G

install -d -o root -g root -m 0700 "${STATE_ROOT}"
# 요청 디렉터리의 소유권은 처음 만들 때만 정한다 — 비-root backend 호스트는 설치 뒤 backend
# 계정으로 chown해 두고, 다음 설치가 그것을 root로 되돌리면 회전 요청이 조용히 막힌다.
if [[ -e "${REQUEST_ROOT}" ]]; then
  [[ -d "${REQUEST_ROOT}" && ! -L "${REQUEST_ROOT}" ]] || die "request root is not a directory: ${REQUEST_ROOT}"
  (( (8#$(stat -c '%a' "${REQUEST_ROOT}") & 022) == 0 )) || die "request root is group/other-writable: ${REQUEST_ROOT}"
else
  install -d -o root -g root -m 0700 "${REQUEST_ROOT}"
fi

git_src() { git --no-replace-objects -C "${SRC}" "$@" 9>&-; }
git_src cat-file -e "${SHA}^{commit}" 2>/dev/null || die "revision ${SHA} is not in ${SRC}; fetch it first"

NAME="ktdm-release-${SHA}"
REL="/opt/${NAME}"
# basename — 손으로 만든 절대 symlink여도 아래 비교·GC가 같은 이름을 본다.
PREV="$(basename -- "$(readlink -- "${APP}")")"
if [[ "$(cat "${REL}/.ktdm-source-revision" 2>/dev/null)" != "${SHA}" ]]; then
  [[ "${PREV}" != "${NAME}" ]] || die "the active release has no revision marker: ${REL}"
  rm -rf -- "${REL}"
  install -d -o root -g root -m 0755 "${REL}"
  # >>> extract
  git_src archive --format=tar "${SHA}" | tar -x --no-same-owner -C "${REL}"
  # archive의 mode에는 tar.umask(기본 002)가 들어간다. 실행 비트는 git index가 정본이다.
  chmod -R go-w "${REL}"
  # <<< extract
  python3 -I -m venv "${REL}/backend/.venv"
  "${REL}/backend/.venv/bin/python" -I -m pip install -q --no-index \
    --find-links "${WHEELHOUSE}" "${REL}/backend"
  # ktdctl은 설치 root 경로로 돈다 — sys.prefix와 project root가 release 경로로 풀리면
  # 레지스트리·요청 파일이 트리 안으로 떨어진다.
  cat > "${REL}/backend/.venv/bin/ktdctl" <<EOF
#!${APP}/backend/.venv/bin/python
import os
os.environ["KOR_TRAVEL_DOCKER_MANAGER_PROJECT_ROOT"] = "${APP}"
from kor_travel_docker_manager.cli import main
raise SystemExit(main())
EOF
  # project root를 주지 않으면 import 시 만들어지는 singleton이 site-packages 기준으로 compose를 찾아
  # 헛된 'not found'를 남긴다.
  KOR_TRAVEL_DOCKER_MANAGER_PROJECT_ROOT="${REL}" "${REL}/backend/.venv/bin/python" -I \
    -c 'import kor_travel_docker_manager.cli'
  printf '%s\n' "${SHA}" > "${REL}/.ktdm-source-revision"
fi
# UI는 docker-compose.yml을 제자리에서 고친다. C6c 보호 참조의 원본(ADR-51 결정 5)은 git에서 매번 다시
# 쓰는 이 사본이다 — 같은 revision을 다시 설치해도(추출을 건너뛰어도) 빠진 사본이 복구된다.
git_src show "${SHA}:docker-compose.yml" > "${REL}/.ktdm-release-compose.yml.tmp"
chmod 0444 "${REL}/.ktdm-release-compose.yml.tmp"
mv -f -- "${REL}/.ktdm-release-compose.yml.tmp" "${REL}/.ktdm-release-compose.yml"
# 모든 `.env` 쓰기는 G 아래에 있다(ADR-51 C-2) — 여기서 복사한 것이 곧 live 값이다.
[[ "${PREV}" == "${NAME}" ]] || cp -p -- "${APP}/.env" "${REL}/.env"

# 새 release의 compose가 배포 `.env`로 풀리는지 flip **전에** 본다. compose는 요청한 서비스와
# 무관하게 파일 전체를 interpolate하므로 새 `${X:?}` 하나가 `.env`에 없으면 모든 compose 명령 —
# backend의 ensure·status 전부 — 이 flip 직후부터 죽는다(onboarding §6.5). 실패하면 넘기지 않는다.
# stderr는 원문을 싣지 않는다 — 오류 문구에 값이 섞일 수 있다. compose 파일이 참조하는 변수 이름만
# 골라 낸다.
# >>> preflight
if ! preflight_err="$(docker compose --project-directory "${REL}" --file "${REL}/docker-compose.yml" \
  --env-file "${REL}/.env" config --quiet 2>&1 >/dev/null 9>&-)"; then
  referenced="$(grep -oE '\$\{?[A-Za-z_][A-Za-z0-9_]*' "${REL}/docker-compose.yml" | tr -d '${' | sort -u)"
  named="$(printf '%s\n' "${preflight_err}" | grep -oE '[A-Za-z_][A-Za-z0-9_]*' | sort -u \
    | grep -Fx -f <(printf '%s\n' "${referenced}") | tr '\n' ' ' || true)"
  die "docker compose config failed for ${REL} with its .env; not flipping (variables named in the error: ${named:-none})"
fi
# <<< preflight

# 새 release가 배포 `.env`로 이 호스트를 식별하는지도 flip **전에** 본다(ADR-58 R3, #477 리뷰 후속).
# 운영 모드의 모든 ktdctl·backend 조회가 `KTDM_HOST`를 요구하므로, 누락·미선언·이 장비에 없는 주소·
# 주소가 겹치는 선언은 flip 직후 status까지 전부 죽인다. 값은 프로세스 env가 아니라 `.env`에서만 본다 —
# backend 유닛은 env에 `KTDM_HOST`를 두지 않는다. 같은 명령이 root `.env`의 소비자 origin 재정의도 거부한다(R2,
# T-MGR-01c). stderr는 registry·validate가 만든 줄(상수·이름·경로·기대값)이라 비밀이 없다 — 위반 줄을 전부 낸다.
# 새 release는 아직 설치 root symlink 뒤가 아니라 trusted 판정이 거짓이다 — 그래서 project root(= REL)와 그 안의
# `.ktdm-source-revision` 표식으로 운영 모드에 들어가고, flip 뒤와 같은 REL의 config·`.env`를 읽는다.
# >>> host-identity
if ! identity_err="$(env -u KTDM_HOST -u KOR_TRAVEL_DOCKER_MANAGER_ENV_FILE \
  -u KOR_TRAVEL_DOCKER_MANAGER_TARGETS_FILE KOR_TRAVEL_DOCKER_MANAGER_PROJECT_ROOT="${REL}" \
  "${REL}/backend/.venv/bin/python" -I -c 'from kor_travel_docker_manager.cli import main
raise SystemExit(main(["targets", "validate", "--json"]))' 2>&1 >/dev/null 9>&-)"; then
  die "new release's targets validate failed with ${REL}/.env; not flipping:
${identity_err}"
fi
# <<< host-identity

# 공용 Dagster plane 컨테이너(멈춘 것 포함)가 붙인 workspace 파일이 새 release에도 있는지 flip **전에** 본다(T-MGR-NH NH-4
# 리뷰 OS-1). bind source는 설치 root symlink를 거친 경로라 flip 뒤 다음 시작에서 새 release의 같은 상대경로를 붙인다 — 그
# 파일이 없으면(옛 별칭 `workspace.yaml`을 붙인 채 별칭이 없는 release로 넘어가면) 마운트가 깨진다. plane은 이름이 아니라
# 컨테이너 안 workspace 경로로 알아본다. 고치는 길은 현재 release로 `ktdctl dagster-plane converge --dry-run` → `--confirm`을
# 먼저 돌려 plane을 호스트 파일(`workspace.<KTDM_HOST>.yaml`) bind로 다시 만드는 것이다.
# >>> plane-binds
# docker가 응답하지 않으면 여기서 멈춘다(무한 대기·조용한 통과 둘 다 막는다) — 이 Manager는 docker 없이 의미가 없다.
timeout 30 docker info >/dev/null 2>&1 9>&- || die "docker daemon did not answer within 30s; not flipping"
plane_ids="$(timeout 30 docker ps -aq 9>&-)" || die "docker ps did not answer within 30s; not flipping"
if [[ -n "${plane_ids}" ]]; then
  # 멈춘 plane(`-a`)도 본다 — 다음 시작이 새 release의 같은 경로를 붙인다.
  plane_sources="$(printf '%s\n' ${plane_ids} | xargs -r timeout 30 docker inspect --format \
    '{{range .Mounts}}{{if eq .Destination "/opt/dagster/dagster_home/workspace.yaml"}}{{println .Source}}{{end}}{{end}}' 9>&-)" \
    || die "docker inspect did not answer within 30s; not flipping"
  while IFS= read -r plane_source; do
    # 이 설치 root 아래의 bind만 — 같은 호스트의 격리 테스트 plane(다른 체크아웃)은 이 release와 무관하다.
    [[ "${plane_source}" == "${APP}/"* ]] || continue
    plane_path="${plane_source#"${APP}/"}"
    [[ -f "${REL}/${plane_path}" ]] || die "running Dagster plane binds ${plane_path}, which the new release does not ship; run \`ktdctl dagster-plane converge --dry-run\` then \`--confirm\` with the current release first, then install"
  done <<< "${plane_sources}"
fi
# <<< plane-binds

# host 파일은 release에서 설치한다. 여기서 실패하면 설치 root와 도는 backend는 그대로다.
install -T -o root -g root -m 0644 -- "${REL}/deploy/tmpfiles.d/kor-travel-docker-manager.conf" \
  /usr/lib/tmpfiles.d/kor-travel-docker-manager.conf
systemd-tmpfiles --create /usr/lib/tmpfiles.d/kor-travel-docker-manager.conf
install -T -o root -g root -m 0644 -- "${REL}/deploy/systemd/ktdm-backend.service" \
  /etc/systemd/system/ktdm-backend.service
env_value() {
  "${REL}/backend/.venv/bin/python" -I -c 'import sys
from dotenv import dotenv_values
print(dotenv_values(sys.argv[1], interpolate=False).get(sys.argv[2]) or "")' "${REL}/.env" "$1"
}
# systemd·logrotate에 들어가는 값: 절대 경로, specifier·공백·따옴표·sed 구분자 없음.
SAFE_PATH='^/[A-Za-z0-9._/+-]+$'
SAFE_NAME='^[a-z_][a-z0-9_-]*$'
units=(ktdm-backend.service)
f_user="$(env_value KTDM_FRONTEND_SERVICE_USER)"
f_dir="$(env_value KTDM_FRONTEND_APP_DIR)"
f_npm="$(env_value KTDM_FRONTEND_NPM)"
f_npm="${f_npm:-/usr/local/bin/npm}"
if [[ -n "${f_user}" && -n "${f_dir}" ]]; then
  [[ "${f_user}" =~ ${SAFE_NAME} && "$(id -u -- "${f_user}" 2>/dev/null || echo 0)" != "0" ]] \
    || die "KTDM_FRONTEND_SERVICE_USER must be a non-root host account"
  [[ "${f_dir}" =~ ${SAFE_PATH} && -d "${f_dir}" && "${f_npm}" =~ ${SAFE_PATH} && -x "${f_npm}" ]] \
    || die "KTDM_FRONTEND_APP_DIR/KTDM_FRONTEND_NPM must be safe absolute paths"
  [[ "$(stat -c '%u' "${f_npm}")" == "0" ]] || die "KTDM_FRONTEND_NPM must be root-owned: ${f_npm}"
  sed -e "s|__KTDM_FRONTEND_USER__|${f_user}|g" -e "s|__KTDM_FRONTEND_DIR__|${f_dir}|g" \
    -e "s|__KTDM_FRONTEND_NPM__|${f_npm}|g" "${REL}/deploy/systemd/ktdm-frontend.service.template" \
    > /etc/systemd/system/ktdm-frontend.service
  units+=(ktdm-frontend.service)
else
  echo "KTDM_FRONTEND_SERVICE_USER/KTDM_FRONTEND_APP_DIR are not set; no frontend unit" >&2
  if [[ -e /etc/systemd/system/ktdm-frontend.service ]]; then
    # 키가 없다는 것은 이 방식으로 돌리지 않는다는 뜻이다 — 옛 계정·경로로 부팅마다 뜨지 않게 한다.
    systemctl disable ktdm-frontend.service
    rm -f -- /etc/systemd/system/ktdm-frontend.service
  fi
fi
b_root="$(env_value KTDM_BACKUP_ROOT)"
if [[ -n "${b_root}" ]]; then
  b_group="$(env_value KTDM_BACKUP_SHARED_GROUP)"
  b_group="${b_group:-root}"
  [[ "${b_root}" =~ ${SAFE_PATH} && -d "${b_root}" && "${b_group}" =~ ${SAFE_NAME} ]] \
    && getent group "${b_group}" >/dev/null || die "KTDM_BACKUP_ROOT/KTDM_BACKUP_SHARED_GROUP are invalid"
  sed -e "s|__KTDM_BACKUP_ROOT__|${b_root}|g" -e "s|__KTDM_BACKUP_GROUP__|${b_group}|g" \
    "${REL}/deploy/logrotate.d/kor-travel-docker-manager.template" > /etc/logrotate.d/kor-travel-docker-manager
else
  echo "KTDM_BACKUP_ROOT is not set; no backup log rotation" >&2
fi
systemctl daemon-reload
systemctl enable "${units[@]}"

# flip. 실행 중인 backend가 새 release의 모듈을 섞어 읽지 않게 멈춘 뒤 넘긴다.
systemctl stop ktdm-backend.service
ln -sfn "${NAME}" "${APP}.new"
mv -T "${APP}.new" "${APP}"
# 깨진 release가 재기동 한도(StartLimitBurst)를 넘겼으면 그 뒤의 롤백 start도 거절된다 — 먼저 푼다.
systemctl reset-failed ktdm-backend.service 2>/dev/null || true
systemctl start ktdm-backend.service || true
# 성공은 /health 200이 **이 유닛의** 프로세스에서 온 것이다 — 재기동 틈에 포트를 차지한 남의
# 프로세스를 새 release로 오인하면 GC까지 돈다.
for _ in $(seq 60); do
  pid="$(systemctl show -p MainPID --value ktdm-backend.service)"
  if curl -fsS --max-time 5 -o /dev/null http://127.0.0.1:12901/health \
    && ss -Hltnp 'sport = :12901' | grep -q "pid=${pid},"; then
    echo "installed ${SHA} (previous: ${PREV#ktdm-release-})"
    if [[ "${PREV}" != "${NAME}" ]]; then
      for old in /opt/ktdm-release-*; do
        # 표식부터 지운다 — 삭제가 중간에 끊겨도 반쪽 트리가 완성 release로 재사용되지 않는다.
        [[ "${old}" == "${REL}" || "${old}" == "/opt/${PREV}" ]] \
          || { rm -f -- "${old}/.ktdm-source-revision"; rm -rf -- "${old}"; }
      done
    fi
    exit 0
  fi
  sleep 1
done
echo "ktdm-backend did not become healthy on ${SHA} (systemctl status ktdm-backend);" >&2
# 롤백은 옛 sha를 **그 sha의 설치기로** 다시 설치하는 것이다 — 이 설치기의 host-identity 검사는 `targets validate --json`이
# 없거나 `KTDM_HOST`를 모르는 옛 release를 거부한다. 그래서 source clone을 PREV로 먼저 옮기라고 안내한다(n150·odroid의
# `~/install-mgr.sh <sha>` 래퍼가 그 순서다).
echo "roll back by reinstalling the previous release with its own installer:" >&2
echo "  git -C ${SRC} checkout --detach ${PREV#ktdm-release-} && sudo ${SRC}/scripts/install-ktdm-trusted-release --expected-source-revision ${PREV#ktdm-release-} ${SRC}" >&2
echo "  (host wrapper: ~/install-mgr.sh ${PREV#ktdm-release-})" >&2
exit 1
